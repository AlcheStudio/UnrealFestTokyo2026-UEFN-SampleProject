# KeyframeSystem の @editable の説明とカテゴリ（ToolTip と Categories に使う）
KeyframeCategory<public><localizes>:message = "キーフレーム"
KeyframeLoopOffsetTip<public><localizes>:message = "1 回の動きで移動する量（cm）。既定 上に 150"
KeyframeLoopSpinTip<public><localizes>:message = "1 回の動きで回る角度（度、ヨー）。0 で回らない。既定 0"
KeyframeLoopMoveTimeTip<public><localizes>:message = "1 回の動きにかける秒数。既定 2"
KeyframeLoopPingPongTip<public><localizes>:message = "true で行って戻る、false で同じ動きを繰り返す。既定 true"
KeyframeLoopPlayOnStartTip<public><localizes>:message = "開始と同時に動かす。スイッチで動かすなら false。既定 true"
