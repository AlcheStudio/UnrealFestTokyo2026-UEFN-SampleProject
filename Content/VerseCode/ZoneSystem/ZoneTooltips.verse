# ZoneSystem の @editable の説明とカテゴリ（ToolTip と Categories に使う）
ZoneCategory<public><localizes>:message = "ゾーン"
VolumeDetectorPollIntervalTip<public><localizes>:message = "出入りを調べる間隔（秒）。既定 0.25"
VolumeDetectorHeightMarginTip<public><localizes>:message = "位置で調べるときに範囲の上下に足す余裕（cm）。薄い床なら 300 くらい。既定 100"
StasisZoneDurationTip<public><localizes>:message = "プレイヤーを固める秒数。既定 3"
RandomTeleportZoneRadiusTip<public><localizes>:message = "移す範囲の半径（cm）。既定 1500"
RandomTeleportZoneMinRadiusTip<public><localizes>:message = "これより近くへは移さない距離（cm）。Radius 未満にする。既定 500"
PrintAreaRadiusTip<public><localizes>:message = "Print を通す範囲の水平半径（cm）。既定 2000"
