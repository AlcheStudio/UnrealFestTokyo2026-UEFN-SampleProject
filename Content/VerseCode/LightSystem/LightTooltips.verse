# LightSystem の @editable の説明とカテゴリ（ToolTip と Categories に使う）
LightCategory<public><localizes>:message = "ライト"

# light_color_cycle_component
ColorCycleFirstColorTip<public><localizes>:message = "1 番目に出す色"
ColorCycleSecondColorTip<public><localizes>:message = "2 番目に出す色"
ColorCycleThirdColorTip<public><localizes>:message = "3 番目に出す色"
ColorCycleIntervalTip<public><localizes>:message = "1 色あたりの秒数。0 で切り替わらない。既定 1"

# light_pulse_component
PulseColorATip<public><localizes>:message = "暗いときの色"
PulseColorBTip<public><localizes>:message = "明るいときの色"
PulseMinIntensityTip<public><localizes>:message = "暗いときの明るさ（カンデラ）。既定 30"
PulseMaxIntensityTip<public><localizes>:message = "明るいときの明るさ（カンデラ）。既定 600"
PulseRadiusTip<public><localizes>:message = "光が届く範囲（cm）。既定 1000"
PulsePeriodTip<public><localizes>:message = "暗い→明るい→暗いの 1 往復にかける秒数。0.1 未満は 0.1。既定 2"
