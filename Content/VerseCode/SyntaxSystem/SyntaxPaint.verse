using { /Verse.org/Colors }

# SyntaxSystem のキューブが状態を見せるときの色（塗るのは UtilitySystem の PaintCube）
SyntaxIdleColor<internal>:color = color{R := 0.35, G := 0.35, B := 0.35}
SyntaxWaitColor<internal>:color = color{R := 1.0, G := 0.8, B := 0.1}
SyntaxSuccessColor<internal>:color = color{R := 0.1, G := 1.0, B := 0.2}
SyntaxFailColor<internal>:color = color{R := 1.0, G := 0.1, B := 0.1}
