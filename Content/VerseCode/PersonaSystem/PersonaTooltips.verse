# PersonaSystem の @editable の説明とカテゴリ（ToolTip と Categories に使う）
PersonaCategory<public><localizes>:message = "ペルソナ"
PersonaNpcSpawnerTip<public><localizes>:message = "この NPC を出す NPC スポナー。自動スポーンは切り、Verse の SpawnAt でだけ出す"
PersonaNpcTalkRadiusTip<public><localizes>:message = "この距離（cm）まで近づいたプレイヤーを相手にする。既定 500"
PersonaSpeakerInstructionsTip<public><localizes>:message = "近づいたときに AI へ出す指示（何を話すか）"
PersonaOracleQuestionTip<public><localizes>:message = "インタラクトされるたびに AI へ尋ねる質問"
PersonaPersonalityTip<public><localizes>:message = "NPC の性格（AI への指示）。開始時に persona_component へ入れる"
PersonaGuideCanFollowTip<public><localizes>:message = "「ついてきて」「案内して」と言われたらプレイヤーについていく。オフなら、ついていけないと答える。既定 オン"
PersonaGuideFollowDistanceTip<public><localizes>:message = "ついていくときに相手と保つ距離（cm）。既定 300"
PersonaSubtitleTextSizeTip<public><localizes>:message = "字幕の文字の大きさ。既定 28"
PersonaSubtitleMarginTip<public><localizes>:message = "画面の下端から字幕までの余白（px）。既定 160"
PersonaSubtitleTextColorTip<public><localizes>:message = "字幕の文字の色。既定 白"
PersonaSubtitleMaxWidthTip<public><localizes>:message = "字幕の横幅（px、1080p 基準）。これを超える文章は折り返す。既定 1100"
PersonaSubtitleBackgroundOpacityTip<public><localizes>:message = "字幕の背景（黒）の濃さ。0 で透明、1 で不透明。既定 0.6"
