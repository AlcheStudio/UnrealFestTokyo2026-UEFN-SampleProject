# InteractSystem の @editable の説明とカテゴリ（ToolTip と Categories に使う）
InteractCategory<public><localizes>:message = "インタラクト"
InteractHoldIdleColorTip<public><localizes>:message = "待機中（押していない / 途中で離した）の色。既定 灰"
InteractHoldHoldColorTip<public><localizes>:message = "押している間の色。既定 黄"
InteractHoldDoneColorTip<public><localizes>:message = "長押しが完了したときの色。既定 緑"
InteractSwitchStartOnTip<public><localizes>:message = "開始時に ON にしておくか。既定 false"
SwitchLightInvertTip<public><localizes>:message = "true で逆動作。ON で消えて OFF で点く。既定 false"
SwitchEnableInvertTip<public><localizes>:message = "true で逆動作。ON で消えて OFF で出る。既定 false"
SwitchKeyframeInvertTip<public><localizes>:message = "true で逆動作。ON で止まり OFF で動く。既定 false"
