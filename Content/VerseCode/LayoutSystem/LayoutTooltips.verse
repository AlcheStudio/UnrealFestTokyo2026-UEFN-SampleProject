# LayoutSystem の @editable の説明とカテゴリ（ToolTip と Categories に使う）
LayoutCategory<public><localizes>:message = "レイアウト"
AreaFloorFloorColorTip<public><localizes>:message = "床の色。既定 水色"
AreaFloorGlowTip<public><localizes>:message = "面の光り方（倍率）。0 で光らない。既定 0.5"
AreaFloorOpacityTip<public><localizes>:message = "面の透け具合。0 で透明、1 で不透明。既定 0.35"
AreaFloorGridCountTip<public><localizes>:message = "マス目の数（一辺あたり）。既定 8"
AreaLabelAreaNameTip<public><localizes>:message = "このエリアの名前。入ったプレイヤーの画面の右中央に出る"
AreaLabelSummaryTip<public><localizes>:message = "このエリアの簡単な紹介。案内役の NPC が、ついてきている人がここに入ったときに話す。空なら話さない"
AreaNameHudTextSizeTip<public><localizes>:message = "右中央に出すエリア名の文字の大きさ。既定 36"
AreaNameHudMarginTip<public><localizes>:message = "画面の右端からの余白（px）。既定 48"
AreaNameHudTextColorTip<public><localizes>:message = "右中央に出すエリア名の文字の色。既定 水色"
HudCleanupHealthTip<public><localizes>:message = "体力とシールドの表示を隠す。既定 オフ（展示では体力を見せる）"
HudCleanupMinimapTip<public><localizes>:message = "ミニマップと地図の案内を隠す。既定 オン"
HudCleanupBuildTip<public><localizes>:message = "建築メニューと素材の表示を隠す。既定 オン"
HudCleanupTeamTip<public><localizes>:message = "チーム情報・人数・撃破数を隠す。既定 オン"
HudCleanupRoundTip<public><localizes>:message = "ラウンドとストームの情報を隠す。既定 オン"
HudCleanupExperienceTip<public><localizes>:message = "経験値の表示を隠す。既定 オン"
HudCleanupPickupTip<public><localizes>:message = "拾ったアイテムの流れを隠す。アイテムの展示で見たいので既定 オフ"
