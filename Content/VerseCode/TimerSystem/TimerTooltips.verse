# TimerSystem の @editable の説明とカテゴリ（ToolTip と Categories に使う）
TimerCategory<public><localizes>:message = "タイマー"
CountdownTimerSecondsTip<public><localizes>:message = "カウントダウンの長さ（秒）。既定 10"
CountdownTimerPlayRateTip<public><localizes>:message = "進む速さ（倍率）。1 で等速、2 で倍速。既定 1"
CountdownTimerIdleColorTip<public><localizes>:message = "待っているときのキューブの色。既定 グレー"
CountdownTimerRunningColorTip<public><localizes>:message = "カウントダウン中のキューブの色。既定 黄"
CountdownTimerDoneColorTip<public><localizes>:message = "終わったときのキューブの色。既定 緑"
