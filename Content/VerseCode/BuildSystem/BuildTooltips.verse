# BuildSystem の @editable の説明とカテゴリ（ToolTip と Categories に使う）
BuildCategory<public><localizes>:message = "ビルド"
BuildRingCountTip<public><localizes>:message = "作るキューブの数。既定 6"
BuildRingRadiusTip<public><localizes>:message = "輪の半径（cm）。既定 250"
BuildRingSpeedTip<public><localizes>:message = "回る速さ（度 / 秒）。マイナスで逆回り。既定 45"
BuildRingSizeTip<public><localizes>:message = "キューブの大きさ（倍率）。既定 0.4"
BuildRingBobHeightTip<public><localizes>:message = "上下に揺らす幅（cm）。0 なら bob_component を付けない。既定 40"
BuildRingColorTip<public><localizes>:message = "キューブの色。既定 オレンジ"
